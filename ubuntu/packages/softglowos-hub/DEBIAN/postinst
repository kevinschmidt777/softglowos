#!/bin/sh
set -e

if [ "$1" = configure ]; then
  # Crash reports for every user (they only send with consent)
  systemctl --global enable softglowos-crash-reporter.service >/dev/null 2>&1 || true
  if [ -f /usr/share/applications/goxlr-utility.desktop ]; then
    # The Hub is the only GoXLR interface; the daemon stays the driver
    desktop-file-edit --set-key=NoDisplay --set-value=true \
      /usr/share/applications/goxlr-utility.desktop 2>/dev/null || true
  fi
fi
