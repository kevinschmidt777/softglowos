#!/bin/sh
# GNOME Software's app entry is rebuilt by softglowos-refresh, hidden
set -e

if [ "$1" = install ] || [ "$1" = upgrade ]; then
  dpkg-divert --package softglowos-store --add --rename \
    --divert /usr/share/applications/org.gnome.Software.desktop.distrib \
    /usr/share/applications/org.gnome.Software.desktop
fi
