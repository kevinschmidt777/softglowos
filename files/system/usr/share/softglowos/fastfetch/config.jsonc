// SoftglowOS fastfetch config: our glow dot as logo, teal keys and plain-text
// labels (our terminal font Geist Mono has no Nerd Font icons).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/softglowos/fastfetch/logo.txt",
        "color": {
            "1": "38;2;33;144;164"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;33;144;164",
            "title": "38;2;33;144;164"
        }
    },
    "modules": [
        "title",
        "break",
        { "type": "os", "key": "OS      ", "format": "{pretty-name}" },
        { "type": "kernel", "key": "Kernel  ", "format": "{release}" },
        { "type": "uptime", "key": "Uptime  " },
        "break",
        { "type": "cpu", "key": "CPU     " },
        { "type": "gpu", "key": "GPU     " },
        { "type": "memory", "key": "Memory  " },
        { "type": "disk", "key": "Disk    ", "hideFS": "overlay" },
        { "type": "display", "key": "Display " },
        "break",
        { "type": "de", "key": "Desktop " },
        { "type": "shell", "key": "Shell   " },
        { "type": "terminal", "key": "Terminal" }
    ]
}
