# SoftglowOS replacement for Bazzite's file of the same name, so its fetch
# aliases show our logo and colors instead of Bazzite's.
alias fastfetch='/usr/bin/fastfetch -c /usr/share/softglowos/fastfetch/config.jsonc'
alias neofetch='/usr/bin/fastfetch -c /usr/share/softglowos/fastfetch/config.jsonc'
alias neowofetch='/usr/bin/fastfetch -c /usr/share/softglowos/fastfetch/config.jsonc'
