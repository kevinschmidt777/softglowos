#!/usr/bin/env python3
"""Starts OBS (its app entry runs this instead of obs). On the very first
start, when there are no OBS settings yet, it prepares them first:

- the hardware encoder of the graphics card: NVENC with the NVIDIA driver,
  VA-API on AMD and Intel, x264 as a fallback
- the SoftglowOS mixer as global audio, so it plays in every scene:
  track 1 = Stream-Mix (what goes into the stream), tracks 2-5 = mic, chat,
  music and system alone for editing; recordings keep all five
- no scenes beyond OBS's empty default one, and OBS's own auto-configuration
  wizard still runs for resolution and bitrate
- OBS's remote control (obs-websocket, port 4455) with a random password,
  which also goes into StreamController's OBS plugin, so the Stream Deck
  controls OBS right away. It's reachable on the home network too (Ubuntu
  has no firewall on by default), the password protects it.

Existing OBS settings are never touched, except for one thing: audio sources
on the game, browser or console channel of SoftglowOS before 1.1.0 move to
system, where that sound plays now (see migrate())."""
import json
import os
import re
import secrets
import subprocess
from pathlib import Path

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'obs-studio'
WEBSOCKET_PORT = 4455
STREAMCONTROLLER_OBS = (Path.home() / '.var' / 'app' / 'com.core447.StreamController' / 'data'
                        / 'settings' / 'plugins' / 'com_core447_OBSPlugin' / 'settings.json')
NAME = 'SoftglowOS'
GERMAN = os.environ.get('LANG', '').startswith('de')

# Global audio slot -> (source name, OBS source type, device, track)
AUDIO = (
    ('DesktopAudioDevice1', 'Stream-Mix', 'pulse_output_capture', 'softglowos.stream-mix.monitor', 1),
    ('AuxAudioDevice1', 'Mikrofon' if GERMAN else 'Microphone', 'pulse_input_capture', 'softglowos.mic', 2),
    ('AuxAudioDevice2', 'Chat', 'pulse_input_capture', 'softglowos.chat.stream.out', 3),
    ('AuxAudioDevice3', 'Musik' if GERMAN else 'Music', 'pulse_input_capture', 'softglowos.music.stream.out', 4),
    ('DesktopAudioDevice2', 'System', 'pulse_input_capture', 'softglowos.system.stream.out', 5),
)

# Channels that SoftglowOS 1.1.0 folded into system
SYSTEM_TRACK = 'softglowos.system.stream.out'
OLD_TRACKS = ('softglowos.game.stream.out', 'softglowos.browser.stream.out',
              'softglowos.console.stream.out')
GLOBAL_AUDIO = ('DesktopAudioDevice1', 'DesktopAudioDevice2', 'AuxAudioDevice1',
                'AuxAudioDevice2', 'AuxAudioDevice3', 'AuxAudioDevice4')


def vaapi_h264():
    """Whether the graphics card encodes H.264 through VA-API (a render node
    alone isn't enough, VMs have one without an encoder)."""
    try:
        info = subprocess.run(['vainfo', '--display', 'drm'], capture_output=True,
                              text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return re.search(r'VAProfileH264\w*\s*:\s*VAEntrypointEncSlice', info) is not None


def encoder():
    if Path('/proc/driver/nvidia/version').exists():
        return 'obs_nvenc_h264_tex'
    if vaapi_h264():
        return 'ffmpeg_vaapi_tex'
    return 'obs_x264'


def prepare():
    scene = 'Szene' if GERMAN else 'Scene'
    collection = {
        'name': NAME,
        'current_scene': scene,
        'current_program_scene': scene,
        'scene_order': [{'name': scene}],
        'sources': [{
            'id': 'scene', 'versioned_id': 'scene', 'name': scene,
            'settings': {'items': [], 'id_counter': 0},
        }],
    }
    for slot, name, kind, device, track in AUDIO:
        collection[slot] = {
            'id': kind, 'versioned_id': kind, 'name': name,
            'settings': {'device_id': device},
            'mixers': 1 << (track - 1),
        }

    profile = CONFIG / 'basic' / 'profiles' / NAME
    scenes = CONFIG / 'basic' / 'scenes'
    profile.mkdir(parents=True)
    scenes.mkdir(parents=True)
    (scenes / f'{NAME}.json').write_text(json.dumps(collection, indent=4))
    (profile / 'basic.ini').write_text(
        f'[General]\nName={NAME}\n\n'
        '[Output]\nMode=Advanced\n\n'
        # Stream track 1, record all five tracks (bit mask)
        f'[AdvOut]\nEncoder={encoder()}\nTrackIndex=1\nRecTracks=31\n')
    (CONFIG / 'user.ini').write_text(
        f'[Basic]\nProfile={NAME}\nProfileDir={NAME}\n'
        f'SceneCollection={NAME}\nSceneCollectionFile={NAME}\n')
    connect_stream_deck()


def connect_stream_deck():
    """Turns on obs-websocket and gives StreamController's OBS plugin the same
    password, unless the user already set up a connection there."""
    password = secrets.token_urlsafe(18)
    websocket = CONFIG / 'plugin_config' / 'obs-websocket' / 'config.json'
    websocket.parent.mkdir(parents=True, exist_ok=True)
    websocket.write_text(json.dumps({
        'alerts_enabled': False, 'auth_required': True, 'first_load': False,
        'server_enabled': True, 'server_password': password, 'server_port': WEBSOCKET_PORT,
    }, indent=2))

    try:
        settings = json.loads(STREAMCONTROLLER_OBS.read_text())
    except (OSError, ValueError):
        settings = {}
    connections = settings.get('connections') or []
    if any(c.get('password') for c in connections) or settings.get('password'):
        return
    settings['connections'] = [{'id': 'default', 'name': 'OBS', 'ip': 'localhost',
                                'port': WEBSOCKET_PORT, 'password': password}]
    settings['default_connection'] = 'default'
    STREAMCONTROLLER_OBS.parent.mkdir(parents=True, exist_ok=True)
    STREAMCONTROLLER_OBS.write_text(json.dumps(settings, indent=4))


def migrate_collection(collection):
    """Points the audio sources of the old game, browser and console channels
    at system. Of the global ones the first becomes "System" (unless there is
    one already) and the others go, so the PC sound isn't recorded twice.
    Returns whether anything changed."""
    changed = False
    has_system = any(collection.get(slot, {}).get('settings', {}).get('device_id') == SYSTEM_TRACK
                     for slot in GLOBAL_AUDIO)
    for slot in GLOBAL_AUDIO:
        source = collection.get(slot)
        if not source or source.get('settings', {}).get('device_id') not in OLD_TRACKS:
            continue
        changed = True
        if has_system:
            del collection[slot]
        else:
            source['settings']['device_id'] = SYSTEM_TRACK
            source['name'] = 'System'
            has_system = True
    for source in collection.get('sources', []):
        settings = source.get('settings') or {}
        if settings.get('device_id') in OLD_TRACKS:
            settings['device_id'] = SYSTEM_TRACK
            changed = True
    return changed


def migrate():
    for path in (CONFIG / 'basic' / 'scenes').glob('*.json'):
        try:
            text = path.read_text()
            if not any(track in text for track in OLD_TRACKS):
                continue
            collection = json.loads(text)
        except (OSError, ValueError):
            continue
        if migrate_collection(collection):
            path.with_name(path.name + '.before-1.1.0').write_text(text)
            path.write_text(json.dumps(collection, indent=4))


if __name__ == '__main__':
    import sys
    try:
        if CONFIG.exists():
            migrate()
        else:
            prepare()
    except OSError as error:
        print(f'softglowos-obs: could not prepare OBS: {error}', file=sys.stderr)
    os.execvp('obs', ['obs', *sys.argv[1:]])
