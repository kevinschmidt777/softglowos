#!/usr/bin/env bash
# Lands every login on the desktop. Just Perfection hides the overview GNOME
# shows after logging in, but only when it is loaded before GNOME's startup
# animation, and GNOME loads extensions asynchronously. When the overview
# still opens, this closes it, once.
#
# It waits for GNOME's "GNOME Shell started" message first: closing the
# overview during the startup animation, before its first layout, leaves the
# animation unfinished for good (GNOME 50), and with it an invisible pane that
# swallows every click and a mode that ignores Super and the VT switch.
set -uo pipefail

shell=(gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell
  --method org.freedesktop.DBus.Properties)
started=MESSAGE_ID=f3ea493c22934e26811cd62abe8e203a

for _ in $(seq 240); do
  pid=$(pgrep -u "$UID" -x gnome-shell | head -n1)
  if [ -n "$pid" ] && [ -n "$(journalctl --user -b -q -o cat "$started" "_PID=$pid" 2>/dev/null)" ]; then
    # Nobody can open the overview before this point, so if it is open, it is
    # GNOME's.
    if [ "$("${shell[@]}".Get org.gnome.Shell OverviewActive 2>/dev/null)" = "(<true>,)" ]; then
      "${shell[@]}".Set org.gnome.Shell OverviewActive '<false>' >/dev/null
    fi
    exit 0
  fi
  sleep 0.25
done
