# SoftglowOS defaults on top of Bazzite's zz0-* overrides.

[org.gnome.shell]
# Dock favorites; the Hub joins once it exists
favorite-apps=['org.gnome.Nautilus.desktop', 'google-chrome.desktop', 'com.obsproject.Studio.desktop', 'discord.desktop', 'steam.desktop', 'org.gnome.Ptyxis.desktop']

# Bazzite's list plus Dash to Dock, Night Theme Switcher and Just Perfection.
# The magic lamp minimize effect is dropped because it is decorative (see DESIGN.md).
# Logo Menu shows our logo, configured in /etc/dconf/db/distro.d/20-softglowos-logomenu.
enabled-extensions=['logomenu@aryan_k', 'just-perfection-desktop@just-perfection', 'dash-to-dock@micxgx.gmail.com', 'nightthemeswitcher@romainvigier.fr', 'appindicatorsupport@rgcjonas.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'gsconnect@andyholmes.github.io', 'blur-my-shell@aunetx', 'hotedge@jonathan.jdoda.ca', 'caffeine@patapon.info', 'add-to-steam@pupper.space', 'restartto@tiagoporsch.github.io', 'bazaar-integration@kolunmi.github.io']

# Mac-style dock: bottom, always visible
[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
intellihide=false
extend-height=false
dash-max-icon-size=48
show-trash=false
show-mounts=false
disable-overview-on-startup=true

# macOS-style top bar: logo menu on the left, clock next to the status icons
[org.gnome.shell.extensions.just-perfection]
activities-button=false
clock-menu-position=1
startup-status=0
support-notifier-type=0

# Window buttons on the right
[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'
titlebar-font='Geist Medium 11'

# Geist everywhere, GNOME's teal as the accent (see DESIGN.md)
[org.gnome.desktop.interface]
font-name='Geist 11'
document-font-name='Geist 11'
monospace-font-name='Geist Mono 11'
accent-color='teal'

[org.gnome.desktop.background]
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/softglowos/softglowos-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/softglowos/softglowos-dark.jpg'

[org.gnome.desktop.screensaver]
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/softglowos/softglowos-dark.jpg'

# No system sounds, so nothing beeps into a microphone or a stream
[org.gnome.desktop.sound]
event-sounds=false
input-feedback-sounds=false

# No GNOME donation reminder notifications (the Settings banner is removed
# by hide-gnome-donate.sh)
[org.gnome.settings-daemon.plugins.housekeeping]
donation-reminder-enabled=false
