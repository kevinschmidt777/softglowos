# The live ISO: SoftglowOS (the AMD/Intel image) as a live desktop that
# opens the installer, with both images to install in its container storage.
# Built by the "Build disk images" workflow and turned into an ISO with
# Titanoboa. Locally (needs podman, x86_64):
#   podman build --cap-add sys_admin --security-opt label=disable \
#     -t localhost/softglowos-live installer/

ARG REGISTRY=ghcr.io/kevinschmidt777
ARG TAG=latest

FROM ${REGISTRY}/softglowos:${TAG}
ARG REGISTRY
ARG TAG
RUN --mount=type=bind,source=.,target=/src \
    REGISTRY="$REGISTRY" TAG="$TAG" /src/build.sh
