[Unit]
Description=Set the keyboard layout of the SoftglowOS live system by location
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# "active" once done, which softglowos-installer waits for
RemainAfterExit=yes
ExecStart=/usr/libexec/softglowos-live-keyboard

[Install]
WantedBy=multi-user.target
