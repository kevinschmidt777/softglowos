#!/usr/bin/env bash
# Stages another SoftglowOS image (an ostree container reference like
# "ostree-image-signed:docker://ghcr.io/kevinschmidt777/softglowos:beta");
# it becomes active with the next restart, settings, apps and files stay.
# Only ever called as root by softglowos-switch-gpu and
# softglowos-switch-channel, which pick the target themselves.
set -euo pipefail

target=$1
[[ $target =~ /kevinschmidt777/softglowos(-nvidia)?:[A-Za-z0-9._-]+$ ]] || { echo "Unexpected target: $target" >&2; exit 1; }

if bootc status --format=json 2>/dev/null | jq -e '.status.booted.image' >/dev/null; then
  case "$target" in
    ostree-image-signed:docker://*) exec bootc switch --enforce-container-sigpolicy "${target#*docker://}" ;;
    ostree-unverified-registry:*) exec bootc switch "${target#*:}" ;;
  esac
fi
exec rpm-ostree rebase "$target"
