#!/usr/bin/env bash
# Switches to the SoftglowOS image that fits the graphics card (see
# softglowos-gpu-check); it becomes active with the next restart. Settings,
# apps and files all stay. Runs as root without a password (the Hub starts
# it through pkexec), so it picks the target itself and only ever switches
# between our two images.
set -euo pipefail

target=$("$(dirname "$0")/softglowos-gpu-check" --target) || { echo "Nothing to switch" >&2; exit 0; }
exec "$(dirname "$0")/softglowos-rebase" "$target"
