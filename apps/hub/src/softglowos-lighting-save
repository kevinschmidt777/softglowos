#!/usr/bin/env python3
# Keeps the current lighting as the OpenRGB profile "SoftglowOS", which the
# lighting service loads on the next login (run when the service stops, so
# changes made in the OpenRGB app stay too).

import os
import sys

sys.path.insert(1, os.path.dirname(os.path.abspath(__file__)))

from hub import lighting

try:
    lighting.save_profile(lighting.connect(timeout=2))
except OSError as error:
    sys.exit(f'Lighting not saved: {error}')
